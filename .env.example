# =====================================================================
# Discord AI Conversational Bot - Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Discord Bot Token (REQUIRED to run live on Discord)
# ---------------------------------------------------------------------
# Obtain from https://discord.com/developers/applications
# Create an App -> Navigate to "Bot" -> Click "Reset Token" -> Copy token here.
# IMPORTANT: Under "Privileged Gateway Intents", enable "Message Content Intent".
DISCORD_TOKEN=your_discord_bot_token_here

# ---------------------------------------------------------------------
# 2. AI Provider Settings (Optional for offline simulation, required for live LLM)
# ---------------------------------------------------------------------
# API key from OpenAI, Groq, OpenRouter, Together, etc.
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# LLM Model Name
# OpenAI examples:     gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Groq examples:       llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# OpenRouter examples: meta-llama/llama-3.1-8b-instruct:free
# Ollama examples:     llama3.2, mistral, deepseek-r1
OPENAI_MODEL=gpt-4o-mini

# Custom Base URL (Leave empty for default official OpenAI API)
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1
# LocalAI:    http://localhost:8080/v1
OPENAI_BASE_URL=

# ---------------------------------------------------------------------
# 3. Bot Personality & Memory Configuration
# ---------------------------------------------------------------------
# Default persona: assistant | coder | teacher | creative | sarcastic | pirate | concise
DEFAULT_PERSONA=assistant

# Maximum user message turns to remember per conversation
MAX_HISTORY=10

# Maximum token length for AI responses
MAX_TOKENS=1000

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7

# Conversation memory inactivity reset time in minutes
MEMORY_TIMEOUT_MINUTES=30

# Command prefix for legacy text commands (Slash commands are also active)
COMMAND_PREFIX=!

# Set to true to force offline simulation mode even if an API key is present
MOCK_MODE=false
